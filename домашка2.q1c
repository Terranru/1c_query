<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="Новый запрос">
		<text>ВЫБРАТЬ
	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&amp;ТекМесяц, МЕСЯЦ), КОНЕЦПЕРИОДА(&amp;ТекМесяц, МЕСЯЦ), ДЕНЬ) + 1 КАК ТекМесяц,
	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&amp;ТекМесяц, МЕСЯЦ, -1), МЕСЯЦ), КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&amp;ТекМесяц, МЕСЯЦ, -1), МЕСЯЦ), ДЕНЬ) + 1 КАК Прошлый,
	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&amp;ТекМесяц, МЕСЯЦ, 1), МЕСЯЦ), КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&amp;ТекМесяц, МЕСЯЦ, 1), МЕСЯЦ), ДЕНЬ) + 1 КАК СледМесяц,
	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&amp;ТекМесяц, День), КОНЕЦПЕРИОДА(&amp;ТекМесяц, МЕСЯЦ), ДЕНЬ) + 1 КАК ДнейДо1Числа
</text>
		<parameters>
			<parameter name="ТекМесяц" type="Дата" value="2026-09-29T00:00:00"/>
		</parameters>
	</query>
</querylist>