<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="Номенклатура">
		<text>ВЫБРАТЬ
	Номенклатура.Ссылка КАК Ссылка,
	Номенклатура.Представление КАК Представление,
	Номенклатура.Код КАК Код,
	Номенклатура.Наименование КАК Наименование,
	Номенклатура.Единица КАК Единица,
	Номенклатура.ЦенаПродажи КАК ЦенаПродажи,
	Номенклатура.СтавкаНДС КАК СтавкаНДС,
	Номенклатура.ИмпортныйТовар КАК ИмпортныйТовар,
	Номенклатура.Комментарий КАК Комментарий
ИЗ
	Справочник.Номенклатура КАК Номенклатура
ГДЕ
	НЕ Номенклатура.ЭтоГруппа
	И НЕ Номенклатура.ПометкаУдаления

// представление только для сообшений 
</text>
	</query>
</querylist>