<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="КадровыеДокументы- параметры">
		<text>ВЫБРАТЬ
	КадровыеДокументы.Дата КАК Дата,
	КадровыеДокументы.Номер КАК Номер,
	КадровыеДокументы.Сотрудник КАК Сотрудник,
	КадровыеДокументы.Подразделение КАК Подразделение,
	КадровыеДокументы.Должность КАК Должность,
	КадровыеДокументы.Тип КАК Тип
ИЗ
	ЖурналДокументов.КадровыеДокументы КАК КадровыеДокументы
ГДЕ
	КадровыеДокументы.Подразделение В ИЕРАРХИИ (&amp;Подразделение)
	И КадровыеДокументы.Должность = &amp;Должность
</text>
		<parameters>
			<parameter name="Должность" type="CatalogRef.Должности" value="452bbade-bea7-11e9-a1a2-b06ebf5f4252"/>
			<parameter name="Подразделение" type="CatalogRef.Подразделения" value="a29a40f1-bea7-11e9-a1a2-b06ebf5f4252"/>
		</parameters>
	</query>
	<query name="Номенклатура">
		<text>ВЫБРАТЬ
	Номенклатура.Код КАК Код,
	Номенклатура.Наименование КАК Наименование,
	Номенклатура.Единица КАК Единица,
	Номенклатура.ЦенаПродажи КАК ЦенаПродажи
ИЗ
	Справочник.Номенклатура КАК Номенклатура
ГДЕ
	НЕ Номенклатура.ЭтоГруппа
</text>
		<parameters/>
	</query>
</querylist>