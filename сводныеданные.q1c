<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="Продажи">
		<text>ВЫБРАТЬ
	ПоступлениеТовараТовары.Номенклатура КАК Номенклатура,
	СУММА(ПоступлениеТовараТовары.Количество) КАК Количество,
	СУММА(ПоступлениеТовараТовары.Сумма) КАК Сумма
ИЗ
	Документ.ПоступлениеТовара.Товары КАК ПоступлениеТовараТовары

СГРУППИРОВАТЬ ПО
	ПоступлениеТовараТовары.Номенклатура

ИМЕЮЩИЕ
	СУММА(ПоступлениеТовараТовары.Сумма) &gt; 20000 
</text>
	</query>
	<query name="итоги">
		<text>ВЫБРАТЬ
	ПоступлениеТовараТовары.Номенклатура КАК Номенклатура,
	ПоступлениеТовараТовары.Цена КАК Цена,
	ПоступлениеТовараТовары.Количество КАК Количество,
	ПоступлениеТовараТовары.Сумма КАК Сумма
ИЗ
	Документ.ПоступлениеТовара.Товары КАК ПоступлениеТовараТовары
ИТОГИ
	СУММА(Количество),
	СУММА(Сумма)
ПО
	Номенклатура
</text>
	</query>
</querylist>