<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="Продажи">
		<text>ВЫБРАТЬ
	ПоступлениеТовараТовары.Номенклатура КАК Номенклатура,
	СУММА(ПоступлениеТовараТовары.Количество) КАК Количество,
	СУММА(ПоступлениеТовараТовары.Сумма) КАК Сумма
ИЗ
	Документ.ПоступлениеТовара.Товары КАК ПоступлениеТовараТовары

СГРУППИРОВАТЬ ПО
	ПоступлениеТовараТовары.Номенклатура
</text>
	</query>
</querylist>