<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="Продажи">
		<text>ВЫБРАТЬ
	ПоступлениеТовараТовары.Номенклатура КАК Номенклатура,
	СУММА(ПоступлениеТовараТовары.Количество) КАК Количество,
	СУММА(ПоступлениеТовараТовары.Сумма) КАК Сумма
ИЗ
	Документ.ПоступлениеТовара.Товары КАК ПоступлениеТовараТовары

СГРУППИРОВАТЬ ПО
	ПоступлениеТовараТовары.Номенклатура

ИМЕЮЩИЕ
	СУММА(ПоступлениеТовараТовары.Сумма) &gt; 20000 
</text>
	</query>
	<query name="итоги">
		<text>ВЫБРАТЬ
	ПоступлениеТовараТовары.Ссылка.Поставщик КАК Поставщик,
	ПоступлениеТовараТовары.Номенклатура КАК Номенклатура,
	ПоступлениеТовараТовары.Цена КАК Цена,
	ПоступлениеТовараТовары.Количество КАК Количество,
	ПоступлениеТовараТовары.Сумма КАК Сумма
ИЗ
	Документ.ПоступлениеТовара.Товары КАК ПоступлениеТовараТовары
ИТОГИ
	СУММА(Количество),
	СУММА(Сумма)
ПО
	Поставщик,
	Номенклатура ИЕРАРХИЯ
</text>
	</query>
	<query name="Продоваемые3Товара">
		<text>ВЫБРАТЬ ПЕРВЫЕ 3
	Товары.Номенклатура КАК Номенклатура,
	Товары.Номенклатура.Единица КАК НоменклатураЕдиница,
	СУММА(Товары.Количество) КАК Количество,
	СУММА(Товары.Сумма) КАК Сумма
ИЗ
	Документ.ПродажаТовара.Товары КАК Товары

СГРУППИРОВАТЬ ПО
	Товары.Номенклатура,
	Товары.Номенклатура.Единица

УПОРЯДОЧИТЬ ПО
	Сумма УБЫВ
</text>
	</query>
</querylist>